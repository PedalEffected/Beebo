@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .
@prefix pprops: <http://lv2plug.in/ns/ext/port-props#> .

<https://github.com/PedalEffected/Beebo#BiPoSeq>
	a lv2:Plugin ;
	lv2:symbol "BiPoSeq" ;
	doap:name "BiPoSeq" ;
	doap:license <http://usefulinc.com/doap/licenses/gpl> ;
	lv2:minorVersion 1 ;
	lv2:microVersion 0 ;
	lv2:optionalFeature lv2:hardRTCapable ;
	lv2:port
	[
		a lv2:CVPort , lv2:InputPort ;
		lv2:index 0 ;
		lv2:name "Back Gate" ;
		lv2:symbol "back_gate" ;
		lv2:portProperty lv2:toggled ;
	] ,
	[
		a lv2:CVPort , lv2:InputPort ;
		lv2:index 1 ;
		lv2:name "Play" ;
		lv2:symbol "play" ;
		lv2:portProperty lv2:toggled ;
	] ,
	[
		a lv2:ControlPort , lv2:InputPort ;
		lv2:index 2 ;
		lv2:name "Loop Steps" ;
		lv2:symbol "steps" ;
		lv2:default 16 ;
		lv2:minimum 1 ;
		lv2:maximum 16 ;
		lv2:portProperty lv2:integer ;
	] ,
	[
		a lv2:CVPort , lv2:InputPort ;
		lv2:index 3 ;
		lv2:name "Reset Trigger" ;
		lv2:symbol "reset" ;
		lv2:default 0 ;
		lv2:minimum 0 ;
		lv2:maximum 1 ;
		lv2:portProperty lv2:toggled ;
	] ,
	[
		a lv2:ControlPort , lv2:InputPort ;
		lv2:index 4 ;
		lv2:name "Glide" ;
		lv2:symbol "glide" ;
		lv2:default 0.5 ;
		lv2:minimum 0.0 ;
		lv2:maximum 1.0 ;
		units:unit units:s ;
	] ,
	[
		a lv2:ControlPort , lv2:InputPort ;
		lv2:index 5 ;
		lv2:name "Value 0" ;
		lv2:symbol "val0" ;
		lv2:default 0.0 ;
		lv2:minimum -5.0 ;
		lv2:maximum 5.0 ;
		units:unit units:volt ;
	] ,
	[
		a lv2:ControlPort , lv2:InputPort ;
		lv2:index 6 ;
		lv2:name "Value 1" ;
		lv2:symbol "val1" ;
		lv2:default 0.0 ;
		lv2:minimum -5.0 ;
		lv2:maximum 5.0 ;
		units:unit units:volt ;
	] ,
	[
		a lv2:ControlPort , lv2:InputPort ;
		lv2:index 7 ;
		lv2:name "Value 2" ;
		lv2:symbol "val2" ;
		lv2:default 0.0 ;
		lv2:minimum -5.0 ;
		lv2:maximum 5.0 ;
		units:unit units:volt ;
	] ,
	[
		a lv2:ControlPort , lv2:InputPort ;
		lv2:index 8 ;
		lv2:name "Value 3" ;
		lv2:symbol "val3" ;
		lv2:default 0.0 ;
		lv2:minimum -5.0 ;
		lv2:maximum 5.0 ;
		units:unit units:volt ;
	] ,
	[
		a lv2:ControlPort , lv2:InputPort ;
		lv2:index 9 ;
		lv2:name "Value 4" ;
		lv2:symbol "val4" ;
		lv2:default 0.0 ;
		lv2:minimum -5.0 ;
		lv2:maximum 5.0 ;
		units:unit units:volt ;
	] ,
	[
		a lv2:ControlPort , lv2:InputPort ;
		lv2:index 10 ;
		lv2:name "Value 5" ;
		lv2:symbol "val5" ;
		lv2:default 0.0 ;
		lv2:minimum -5.0 ;
		lv2:maximum 5.0 ;
		units:unit units:volt ;
	] ,
	[
		a lv2:ControlPort , lv2:InputPort ;
		lv2:index 11 ;
