	] ,
	[
		a lv2:ControlPort , lv2:InputPort ;
		lv2:index 15 ;
		lv2:name "Value 10" ;
		lv2:symbol "val10" ;
		lv2:default 0.0 ;
		lv2:minimum -5.0 ;
		lv2:maximum 5.0 ;
		units:unit units:volt ;
	] ,
	[
		a lv2:ControlPort , lv2:InputPort ;
		lv2:index 16 ;
		lv2:name "Value 11" ;
		lv2:symbol "val11" ;
		lv2:default 0.0 ;
		lv2:minimum -5.0 ;
		lv2:maximum 5.0 ;
		units:unit units:volt ;
	] ,
	[
		a lv2:ControlPort , lv2:InputPort ;
		lv2:index 17 ;
		lv2:name "Value 12" ;
		lv2:symbol "val12" ;
		lv2:default 0.0 ;
		lv2:minimum -5.0 ;
		lv2:maximum 5.0 ;
		units:unit units:volt ;
	] ,
	[
		a lv2:ControlPort , lv2:InputPort ;
		lv2:index 18 ;
		lv2:name "Value 13" ;
		lv2:symbol "val13" ;
		lv2:default 0.0 ;
		lv2:minimum -5.0 ;
		lv2:maximum 5.0 ;
		units:unit units:volt ;
	] ,
	[
		a lv2:ControlPort , lv2:InputPort ;
		lv2:index 19 ;
		lv2:name "Value 14" ;
		lv2:symbol "val14" ;
		lv2:default 0.0 ;
		lv2:minimum -5.0 ;
		lv2:maximum 5.0 ;
		units:unit units:volt ;
	] ,
	[
		a lv2:ControlPort , lv2:InputPort ;
		lv2:index 20 ;
		lv2:name "Value 15" ;
		lv2:symbol "val15" ;
		lv2:default 0.0 ;
		lv2:minimum -5.0 ;
		lv2:maximum 5.0 ;
		units:unit units:volt ;
	] ,
	[
		a lv2:CVPort , lv2:OutputPort ;
		lv2:index 21 ;
		lv2:name "Value Out" ;
		lv2:symbol "out" ;
		lv2:minimum -1.0 ;
		lv2:maximum 1.0 ;
	] ,
	[
		a lv2:ControlPort , lv2:OutputPort ;
		lv2:index 22 ;
		lv2:name "current step out" ;
		lv2:symbol "current_step_out" ;
	] ,
	[
		a lv2:ControlPort , lv2:InputPort ;
		lv2:index 23 ;
		lv2:name "BPM" ;
		lv2:symbol "bpm" ;
		lv2:default 120 ;
		lv2:minimum 20 ;
		lv2:maximum 320 ;
	] ,
	[
		a lv2:ControlPort , lv2:InputPort ;
		lv2:index 24 ;
		lv2:name "Note Length" ;
		lv2:symbol "note_length" ;
		lv2:default 0.125 ;
		lv2:minimum 0.03125 ;
		lv2:maximum 1 ;
	] ;
	lv2:documentation """<p>BiPoSeq: bipolar 16 step sequencer. Each step is set in volts from -5 V to +5 V (Hector CV scale; output -1..+1). Runs from an internal BPM clock.</p>""" .

