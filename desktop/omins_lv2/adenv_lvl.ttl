@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .

<http://drobilla.net/plugins/omins/adenv_lvl>
	a lv2:Plugin , lv2:EnvelopePlugin ;
	doap:name "Percussive AD Envelope with levels" ;
	doap:license <http://usefulinc.com/doap/licenses/gpl> ;
	lv2:optionalFeature lv2:hardRTCapable ;
	lv2:port [
		a lv2:CVPort , lv2:InputPort ;
		lv2:index 0 ; lv2:symbol "gate" ; lv2:name "Gate"
	] , [
		a lv2:CVPort , lv2:InputPort ;
		lv2:index 1 ; lv2:symbol "trigger" ; lv2:name "Trigger"
	] , [
		a lv2:ControlPort , lv2:InputPort ;
		lv2:index 2 ; lv2:symbol "init_level" ; lv2:name "Initial Level" ;
		lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0
	] , [
		a lv2:ControlPort , lv2:InputPort ;
		lv2:index 3 ; lv2:symbol "attack_level" ; lv2:name "Attack to Level" ;
		lv2:default 1.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0
	] , [
		a lv2:ControlPort , lv2:InputPort ;
		lv2:index 4 ; lv2:symbol "decay_level" ; lv2:name "Decay to Level" ;
		lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0
	] , [
		a lv2:ControlPort , lv2:InputPort ;
		lv2:index 5 ; lv2:symbol "attack" ; lv2:name "Attack Time (s)" ;
		lv2:default 0.5 ; lv2:minimum 0.0 ; lv2:maximum 5.0
	] , [
		a lv2:ControlPort , lv2:InputPort ;
		lv2:index 6 ; lv2:symbol "decay" ; lv2:name "Decay Time (s)" ;
		lv2:default 0.5 ; lv2:minimum 0.0 ; lv2:maximum 5.0
	] , [
		a lv2:CVPort , lv2:OutputPort ;
		lv2:index 7 ; lv2:symbol "out" ; lv2:name "Envelope Out"
	] , [
		a lv2:CVPort , lv2:InputPort ;
		lv2:index 8 ; lv2:symbol "reset_level" ; lv2:name "Reset Level"
	] .
